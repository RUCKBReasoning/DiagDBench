# Local secrets / machine overrides
.env
.env.*
!.env.example
**/*.local.json
**/config.local.*
# Publish dataset archives; keep extracted samples local.
/DiagDBench/*
!/DiagDBench/Train.zip
!/DiagDBench/Eval.zip
# The oversized dump is distributed as LFS parts and restored locally.
/Database_Instances/postgresql_instances/imdb.dump
/Database_Instances/postgresql_instances/imdb.dump.restore-*
/Database_Instances/postgresql_instances/imdb.dump.part*.tmp
# External schemas, results and private run history
/Data/
/external_inputs/
/Output/
/TMP/
/.conda/
_*/
.maintenance/
**/diagnostic_runs/
**/alert_results/
**/logs/
**/llm_traces/
**/.dbg/
**/revision_state.json
*.lock
*.exit
__pycache__/
*.py[cod]
.venv/
node_modules/
_Back_Up/
*.log
# Functional source is intentionally tracked: Evaluation/, Complie/, Test/.
