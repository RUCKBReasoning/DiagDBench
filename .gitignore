# Local secrets / machine overrides
.env
.env.*
!.env.example
**/*.local.json
**/config.local.*
# Dataset payloads live on Hugging Face; keep only documentation/placeholders.
/DiagDBench/*
!/DiagDBench/README.md
!/DiagDBench/.gitkeep
/Database_Instances/**
!/Database_Instances/**/
!/Database_Instances/README.md
!/Database_Instances/**/.gitkeep
# Metadata created by `hf download --local-dir .`.
/.cache/huggingface/
# External schemas, results and private run history
/Data/
/external_inputs/
/Output/
/TMP/
/.conda/
_*/
.maintenance/
**/diagnostic_runs/
**/alert_results/
**/logs/
**/llm_traces/
**/.dbg/
**/revision_state.json
*.lock
*.exit
__pycache__/
*.py[cod]
.venv/
node_modules/
_Back_Up/
*.log
# Functional source is intentionally tracked: Evaluation/, Complie/, Test/.
