{
  "workflow_type": "dbaiops",
  "key_information_path": "external_inputs/samples/key_information.json",
  "max_turn_num": 20,
  "llm_configuration": {
    "provider": "openai",
    "base_url": "https://api.example.com/v1",
    "model_name": "your-chat-model",
    "temperature": 1,
    "retry_times": 3,
    "api_key_env": "OPENAI_API_KEY",
    "api_key": "",
    "api_version": ""
  },
  "docker_name": "diagbench_dbaiops",
  "host_port": 35310,
  "parallelism_num": 1,
  "conda_env": "dbaiops_baseline",
  "superuser_config": {
    "DB_USER": "root",
    "DB_PASSWORD": "root"
  },
  "output_base_dir": "Output/dbaiops"
}
