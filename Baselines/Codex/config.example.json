{
  "workflow_type": "codex",
  "key_information_path": "Output/YOUR_DATASET/eval_samples/key_information.json",
  "docker_name": "codex_unique_run",
  "host_port": 36280,
  "parallelism_num": 1,
  "max_turn_num": 20,
  "action_timeout": 1800,
  "agent_timeout": 14400,
  "superuser_config": {"DB_USER": "root", "DB_PASSWORD": "root"},
  "output_base_dir": "Output/YOUR_RUN/baselines/codex",
  "llm_configuration": {
    "provider": "enterprise",
    "base_url": "https://YOUR_AUTHORIZED_MODEL_ENDPOINT",
    "api_version": "2024-03-01-preview",
    "model_name": "gpt-6-astra",
    "api_key": "",
    "api_key_env": "CODEX_MODEL_KEY",
    "temperature": 1,
    "timeout": 300,
    "retry_times": 4,
    "request_retry_times": 3,
    "request_retry_delay_seconds": 2,
    "sdk_max_retries": 0,
    "codex_transport": "chat_completions",
    "codex_tool_mode": "json",
    "codex_transport_retries": 2,
    "codex_transport_timeout_seconds": 300
  },
  "codex": {
    "max_aux_actions": 100,
    "max_model_calls": 100,
    "max_model_tokens": 500000,
    "max_specialists": 4,
    "specialist_turns": 6,
    "enable_specialists": true,
    "enable_web_docs": true
  }
}
